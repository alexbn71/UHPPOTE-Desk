# Configuration for local development (copy to .env).
# With "npm run sim" the simulated controller listens on port 60000.
HTTP_PORT=8080
DATA_DIR=./data
# password of the 'admin' user (if empty: generated on first start, printed in the log)
ADMIN_PASSWORD=admin-dev-password
UHPPOTE_BIND_ADDR=0.0.0.0
UHPPOTE_BROADCAST=255.255.255.255:60000
UHPPOTE_LISTEN=0.0.0.0:60001
UHPPOTE_LISTENER_PUBLIC=127.0.0.1:60001
LOG_LEVEL=info
# Home Assistant bridge (optional), e.g. mqtt://192.168.1.10:1883 — see docs/HOME-ASSISTANT.md
MQTT_URL=
