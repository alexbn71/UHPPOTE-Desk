# --- Web -----------------------------------------------------------------------
# Porta dell'interfaccia web (con network_mode host è la porta del NAS)
HTTP_PORT=8080
# Impostare a true se l'app è pubblicata dietro HTTPS (reverse proxy del NAS)
SECURE_COOKIES=false
# Password iniziale dell'utente "admin" (solo al primo avvio; da cambiare al primo accesso).
# Se vuota viene generata e scritta nel log del container.
INITIAL_ADMIN_PASSWORD=

# --- Comunicazione con le schede ------------------------------------------------
# IP del server sull'interfaccia verso le schede (0.0.0.0 = tutte; indicarlo se l'host ha più interfacce)
UHPPOTE_BIND_ADDR=0.0.0.0
# Broadcast per la ricerca delle schede: meglio quello della subnet delle schede, es. 192.168.1.255:60000
UHPPOTE_BROADCAST=255.255.255.255:60000
# Porta UDP su cui ricevere gli eventi
UHPPOTE_LISTEN=0.0.0.0:60001
# OBBLIGATORIO per gli eventi in tempo reale: IP:porta di questo server raggiungibile dalle schede,
# programmato nelle schede come destinazione degli eventi (es. 192.168.1.10:60001)
UHPPOTE_LISTENER_PUBLIC=
UHPPOTE_TIMEOUT_MS=2500
UHPPOTE_RETRIES=1
# true per registrare nel log tutti i pacchetti scambiati (diagnosi)
UHPPOTE_DEBUG=false

# --- Servizi --------------------------------------------------------------------
HEALTH_INTERVAL_SEC=15
COLLECT_INTERVAL_SEC=300
TIME_SYNC_THRESHOLD_SEC=30
INITIAL_BACKFILL=5000
BACKUP_HOUR=2
BACKUP_KEEP=14
LOG_LEVEL=info

# Fuso orario (ora inviata alle schede e report)
TZ=Europe/Rome
