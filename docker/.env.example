# UHPPOTE Desk configuration for Docker (copy to docker/.env).
# Full description of every variable: docs/DOCKER.md

# --- Data folder owner -----------------------------------------------------------
# The application runs as this user/group and /data (named volume or host folder) is given to it.
PUID=1000
PGID=1000

# --- Web -----------------------------------------------------------------------
# Port of the web interface (with host networking this is a port of the server itself)
HTTP_PORT=8080
# Set to true if the app is published over HTTPS (reverse proxy)
SECURE_COOKIES=false
# Password of the "admin" user.
#  - set:   it is applied at every start and cannot be changed from the application
#  - empty: a password is generated on the first start, written to the container log,
#           and must be changed at first login
ADMIN_PASSWORD=

# --- Communication with the controllers ----------------------------------------
# Server IP on the interface facing the controllers (0.0.0.0 = all; set it if the host has several interfaces)
UHPPOTE_BIND_ADDR=0.0.0.0
# Broadcast used to discover controllers: preferably the broadcast of the controllers' subnet, e.g. 192.168.1.255:60000
UHPPOTE_BROADCAST=255.255.255.255:60000
# UDP port on which events are received
UHPPOTE_LISTEN=0.0.0.0:60001
# REQUIRED for real-time events: IP:port of this server as reached by the controllers,
# written into the controllers as the event destination (e.g. 192.168.1.10:60001)
UHPPOTE_LISTENER_PUBLIC=
UHPPOTE_TIMEOUT_MS=2500
UHPPOTE_RETRIES=1
# true to log every packet exchanged with the controllers (diagnostics)
UHPPOTE_DEBUG=false

# --- Services ------------------------------------------------------------------
HEALTH_INTERVAL_SEC=15
COLLECT_INTERVAL_SEC=300
TIME_SYNC_THRESHOLD_SEC=30
INITIAL_BACKFILL=5000
BACKUP_HOUR=2
BACKUP_KEEP=14
LOG_LEVEL=info

# --- Mobile app ---------------------------------------------------------------
# public HTTPS address behind the reverse proxy (fingerprint/Face ID, push). Guide: docs/MOBILE.md
PUBLIC_URL=

# --- Home Assistant (MQTT) -----------------------------------------------------
# broker URL; empty = MQTT disabled. Guide: docs/HOME-ASSISTANT.md
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# false = Home Assistant can see the doors but not open them
MQTT_DOOR_CONTROL=true
# language of the entity names and event texts: en, it, es, fr, de
MQTT_LANGUAGE=en
MQTT_BASE_TOPIC=uhppote-desk
MQTT_DISCOVERY_PREFIX=homeassistant

# Time zone (time set on the controllers and used in reports)
TZ=Europe/Rome
