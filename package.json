{
  "name": "uhppote-desk",
  "version": "1.2.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Web app to manage UHPPOTE UT0311-L0x access controllers",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch --disable-warning=ExperimentalWarning apps/server/src/main.ts\" \"npm run dev -w @uhppote-desk/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "hw": "tsx tools/hwtest/src/cli.ts",
    "sim": "tsx tools/hwtest/src/devsim.ts",
    "pcap": "tsx tools/hwtest/src/pcap-cli.ts",
    "manual": "npm run build --workspace @uhppote-desk/web && tsx docs/manual/build.ts --all",
    "screenshots": "npm run build --workspace @uhppote-desk/web && tsx docs/manual/build.ts --readme",
    "e2e": "npm run build --workspace @uhppote-desk/web && playwright test",
    "dev:server": "tsx watch --disable-warning=ExperimentalWarning apps/server/src/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "26.6.5",
    "@types/smtp-server": "^3.5.13",
    "aedes": "^1.2.0",
    "concurrently": "^10.0.6",
    "fast-check": "4.10.2",
    "prettier": "3.6.2",
    "smtp-server": "^3.19.21",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "uhppoted": "0.9.1",
    "vitest": "5.0.3"
  }
}
